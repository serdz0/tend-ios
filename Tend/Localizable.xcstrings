    "You've snoozed %@ a few times. That's completely fine. Want to change how often it comes up?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úkol „%@“ jste už několikrát odložili. To je úplně v pořádku. Chcete změnit, jak často se objevuje?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've snoozed %@ a few times. That's completely fine. Want to change how often it comes up?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви кілька разів відклали «%@». Це цілком нормально. Хочете змінити, як часто це з’являється?"
          }
        }
      }
    },
    "Your %@ would love a drink today.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostlina „%@“ by dnes ocenila trochu vody."
