    "A good starting point for %@: every %lld days. Pot, light and season all matter, so adjust it to suit your plant.": {
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dobrý začátek (%1$@): zalévat každé %2$lld dny. Záleží i na květináči, světle a ročním období, takže to upravte podle své rostliny."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dobrý začátek (%1$@): zalévat každého %2$lld dne. Záleží i na květináči, světle a ročním období, takže to upravte podle své rostliny."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dobrý začátek (%1$@): zalévat každý den. Záleží i na květináči, světle a ročním období, takže to upravte podle své rostliny."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dobrý začátek (%1$@): zalévat každých %2$lld dní. Záleží i na květináči, světle a ročním období, takže to upravte podle své rostliny."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A good starting point for %1$@: every %2$lld day. Pot, light and season all matter, so adjust it to suit your plant."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A good starting point for %1$@: every %2$lld days. Pot, light and season all matter, so adjust it to suit your plant."
