    "Your phone can't read the odometer, so Tend estimates the due date from how far you drive in a year. Give it a fresh reading now and then and the estimate gets sharper.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon neumí přečíst tachometr, takže Tend odhaduje termín podle toho, kolik ročně najedete. Občas zadejte čerstvý stav a odhad bude přesnější."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone can't read the odometer, so Tend estimates the due date from how far you drive in a year. Give it a fresh reading now and then and the estimate gets sharper."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не може зчитати одометр, тому Tend оцінює термін за тим, скільки ви проїжджаєте за рік. Час від часу вводьте свіже значення, і оцінка стане точнішою."
          }
        }
      }
    },
    "Your plants and your car are happy. Go and enjoy the day.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše rostliny i auto jsou spokojené. Běžte si užít den."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plants and your car are happy. Go and enjoy the day."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші рослини й авто задоволені. Ідіть і насолоджуйтеся днем."
          }
        }
      }
    },
