    "You can switch to a note for each thing under \"How Tend talks to you\" on Today.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na upozornění pro každou věc můžete přepnout v části „Jak s vámi Tend mluví“ na obrazovce Dnes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can switch to a note for each thing under \"How Tend talks to you\" on Today."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейти на сповіщення для кожної справи можна в розділі «Як Tend з вами розмовляє» на екрані «Сьогодні»."
          }
        }
      }
    },
    "You're all caught up": {
      "localizations": {
