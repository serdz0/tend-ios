    "%@ is a little thirsty. A quick drink and you're done.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostlina „%@“ je trochu žíznivá. Rychlé zalití a máte hotovo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a little thirsty. A quick drink and you're done."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослина «%@» трохи спрагла. Швидкий полив — і готово."
          }
        }
      }
    },
    "%@ is coming up about now. A quick odometer check helps.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: už to bude. Pomůže rychlá kontrola tachometru."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is coming up about now. A quick odometer check helps."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: незабаром. Допоможе швидка перевірка одометра."
          }
        }
      }
    },
    "%@ is done.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – hotovo."
