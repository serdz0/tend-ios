            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "З чого почати (%1$@): поливати кожні %2$lld дні. Важливі й горщик, і світло, і пора року, тож підлаштуйте це під свою рослину."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "З чого почати (%1$@): поливати кожні %2$lld днів. Важливі й горщик, і світло, і пора року, тож підлаштуйте це під свою рослину."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "З чого почати (%1$@): поливати кожні %2$lld день. Важливі й горщик, і світло, і пора року, тож підлаштуйте це під свою рослину."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "З чого почати (%1$@): поливати кожні %2$lld дня. Важливі й горщик, і світло, і пора року, тож підлаштуйте це під свою рослину."
                }
